from mediapipe.tasks import python as mp_python
from mediapipe.tasks.python import vision
from mediapipe import Image, ImageFormat

_HAND_MODEL_PATH = "hand_landmarker.task"

def _decode_frames_gesture(video_path: str, max_frames: int = 8) -> list:
    cap = cv2.VideoCapture(video_path)
    if not cap.isOpened():
        return []
    total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT)) or 1
    step = max(1, total // max_frames)
    frames, idx = [], 0
    while len(frames) < max_frames:
        ret, frame = cap.read()
        if not ret:
            break
        if idx % step == 0:
            frames.append(frame)
        idx += 1
    cap.release()
    return frames

def _count_extended(landmarks, handedness_label: str) -> list:
    tips = [4, 8, 12, 16, 20]
    pips = [3, 6, 10, 14, 18]
    extended = []
    # Thumb
    if handedness_label == "Right":
        extended.append(landmarks[tips[0]].x < landmarks[pips[0]].x)
    else:
        extended.append(landmarks[tips[0]].x > landmarks[pips[0]].x)
    # Index..Pinky
    for i in range(1, 5):
        extended.append(landmarks[tips[i]].y < landmarks[pips[i]].y)
    return extended

def _match_6(ext: list) -> bool:
    return ext[0] and ext[4] and not ext[1] and not ext[2] and not ext[3]

def _match_7(ext: list) -> bool:
    return ext[0] and ext[1] and ext[2] and not ext[3] and not ext[4]

def check_gesture(video_path: str, strict: bool = False, max_frames: int = 8) -> tuple:
    frames = _decode_frames_gesture(video_path, max_frames=max_frames)
    if not frames:
        return False, "нет кадров"

    # Настраиваем HandLandmarker
    base_options = mp_python.BaseOptions(model_asset_path=_HAND_MODEL_PATH)
    options = vision.HandLandmarkerOptions(
        base_options=base_options,
        num_hands=2,
        min_hand_detection_confidence=0.4,
    )

    found_6 = False
    found_7 = False
    hands_seen = 0

    with vision.HandLandmarker.create_from_options(options) as landmarker:
        for frame in frames:
            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            mp_image = Image(image_format=ImageFormat.SRGB, data=rgb)
            result = landmarker.detect(mp_image)

            if not result.hand_landmarks:
                continue

            for lm, hand_cls in zip(result.hand_landmarks, result.handedness):
                hands_seen += 1
                label = hand_cls[0].category_name
                ext = _count_extended(lm, label)

                if _match_6(ext):
                    found_6 = True
                if _match_7(ext):
                    found_7 = True
                if not strict and any(ext[1:]):
                    return True, "жест показан"

    if found_6 and found_7:
        return True, "показаны 6 и 7"
    if found_6:
        return True, "показана 6"
    if found_7:
        return True, "показана 7"

    if strict:
        return False, f"жест не распознан (рук: {hands_seen})"
    return (hands_seen > 0, f"рук видно: {hands_seen}")

