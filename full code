        await message.answer("❌ Этот кружок уже засчитан.")
        return

    # 3. Лимит
    daily = await db_get_daily(user_id, today)
    videos_today = daily["videos_count"] if daily else 0
    if videos_today >= DAILY_LIMIT:
        await message.answer(
            f"⏰ Лимит на сегодня: {DAILY_LIMIT} кружков. Возвращайся завтра!"
        )
        return

    # 4. Face ID обязателен?
    stored_face = await db_get_face(user_id)
    if REQUIRE_FACE_MATCH and not stored_face:
        await message.answer("🔐 Сначала зарегистрируй лицо: /register_face")
        return

    status = await message.answer("🎧 Обрабатываю кружок...")

    # Скачиваем видео
    file = await bot.get_file(vn.file_id)
    with tempfile.TemporaryDirectory() as tmp:
        video_path = os.path.join(tmp, "note.mp4")
        audio_path = os.path.join(tmp, "audio.wav")
        await bot.download_file(file.file_path, video_path)

        loop = asyncio.get_running_loop()
        gesture_info = "—"

        # === Лицо ===
        if REQUIRE_FACE_MATCH and stored_face:
            await status.edit_text("👤 Проверяю лицо...")
            face_ok, similarity = await loop.run_in_executor(
                None, verify_video_face, video_path, stored_face, FACE_THRESHOLD
            )
            if not face_ok:
                await status.edit_text(
                    f"❌ <b>Лицо не совпадает</b>\n\n"
                    f"Схожесть: {similarity:.2f} (нужно ≥ {FACE_THRESHOLD}).\n"
                    "Запиши кружок, где тебя хорошо видно.",
                    parse_mode=ParseMode.HTML,
                )
                return

        # === Жест ===
        if REQUIRE_GESTURE:
            await status.edit_text("✋ Проверяю жест...")
            gesture_ok, gesture_info = await loop.run_in_executor(
                None, check_gesture, video_path, GESTURE_STRICT
            )
            if not gesture_ok:
                await status.edit_text(
                    f"❌ <b>Жест не распознан</b>\n\n"
                    f"Детали: {gesture_info}\n"
                    "Покажи пальцами «6» или «7» в кадре.",
                    parse_mode=ParseMode.HTML,
                )
                return

        # === Аудио ===
        await status.edit_text("🎙 Распознаю речь...")

        def _audio_pipeline():
            if not extract_audio(video_path, audio_path):
                return ""
            return transcribe(audio_path)

        text = await loop.run_in_executor(None, _audio_pipeline)

    log.info(f"user={user_id} text='{text}'")

    if not text:
        await status.edit_text("🤔 Не расслышал. Скажи «67» громче.")
        return

    hits = count_67(text)
    if hits == 0:
