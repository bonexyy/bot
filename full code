def get_level(balance: int) -> tuple:
    levels = [
        (0, "Новичок"),
        (67, "Ученик"),
        (670, "Практик"),
        (6_700, "Мастер"),
        (67_000, "Хранитель Баланса"),
    ]
    current = levels[0]
    for threshold, name in levels:
        if balance >= threshold:
            current = (threshold, name)
    return levels.index(current) + 1, current[1]


