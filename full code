def _decode_video_frames(video_path: str, max_frames: int = 5) -> list:
    cap = cv2.VideoCapture(video_path)
    if not cap.isOpened():
        return []
    total = int(cap.get(cv2.CAP_PROP_FRAME_COUNT)) or 1
    step = max(1, total // max_frames)
    frames, idx = [], 0
    while len(frames) < max_frames:
        ret, frame = cap.read()
        if not ret:
            break
        if idx % step == 0:
            frames.append(frame)
        idx += 1
    cap.release()
    return frames


def _get_embedding(image_bgr: np.ndarray) -> Optional[np.ndarray]:
    app = get_face_app()
    faces = app.get(image_bgr)
    if not faces:
        return None
    face = max(faces, key=lambda f: (f.bbox[2] - f.bbox[0]) * (f.bbox[3] - f.bbox[1]))
    return face.normed_embedding


def _cos_sim(a: np.ndarray, b: np.ndarray) -> float:
    return float(np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b) + 1e-8))


def get_face_from_photo(photo_path: str) -> Optional[bytes]:
    img = cv2.imread(photo_path)
    if img is None:
        return None
    emb = _get_embedding(img)
    if emb is None:
        return None
    return emb.astype(np.float32).tobytes()


def verify_video_face(
    video_path: str,
    stored_embedding_bytes: bytes,
    threshold: float = 0.35,
    max_frames: int = 5,
) -> tuple:
    if not stored_embedding_bytes:
        return False, 0.0
    stored = np.frombuffer(stored_embedding_bytes, dtype=np.float32)
    frames = _decode_video_frames(video_path, max_frames=max_frames)
    if not frames:
        return False, 0.0
    best = 0.0
    for frame in frames:
        emb = _get_embedding(frame)
        if emb is None:
            continue
        sim = _cos_sim(emb, stored)
        best = max(best, sim)
        if sim >= threshold:
            return True, sim
    return False, best


